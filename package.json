{
  "name": "strollia-expo",
  "version": "1.1.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "generate:licenses": "node scripts/generate-licenses.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/slider": "5.2.0",
    "@sentry/react-native": "~7.11.0",
    "buffer": "^6.0.3",
    "expo": "^57.0.0",
    "expo-application": "~57.0.0",
    "expo-asset": "~57.0.3",
    "expo-blur": "~57.0.0",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.5",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image-picker": "~57.0.2",
    "expo-keep-awake": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-location": "~57.0.2",
    "expo-media-library": "~57.0.1",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.4",
    "expo-sharing": "~57.0.3",
    "expo-splash-screen": "~57.0.2",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-store-review": "~57.0.0",
    "expo-task-manager": "~57.0.2",
    "fast-xml-parser": "^5.8.0",
    "gifenc": "^1.0.3",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-color-matrix-image-filters": "^8.0.2",
    "react-native-maps": "1.27.2",
    "react-native-purchases": "^10.4.2",
    "react-native-purchases-ui": "^10.4.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "@types/upng-js": "^2.1.5",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.1",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.9.4",
    "react-dom": "19.2.3",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.worktrees/",
      "<rootDir>/.claude/worktrees/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "clearMocks": true
  },
  "overrides": {
    "react-test-renderer": "19.2.3"
  }
}
