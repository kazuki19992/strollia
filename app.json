{
  "expo": {
    "name": "すとろりあ",
    "slug": "strollia",
    "scheme": "strollia",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ja",
        "CFBundleLocalizations": ["ja"],
        "NSLocationWhenInUseUsageDescription": "すとろりあは、移動ルートを記録するために現在地を使用します。",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationAlwaysAndWhenInUseUsageDescription": "すとろりあは、画面を閉じている間も移動ルートを記録するために現在地を使用します。",
        "NSLocationAlwaysUsageDescription": "すとろりあは、画面を閉じている間も移動ルートを記録するために現在地を使用します。",
        "NSPhotoLibraryUsageDescription": "すとろりあは、ジオタグ付き写真を地図上に表示したり、現在地アイコンに使用する画像を選択したりするために写真ライブラリを読み取ります。",
        "CFBundleSpotlightKeywords": [
          "すとろりあ",
          "Strollia",
          "strollia",
          "おさんぽ",
          "散歩",
          "さんぽ",
          "GPSログ",
          "移動ログ",
          "ライフログ",
          "地図",
          "旅行",
          "徒歩",
          "移動",
          "sutororia"
        ]
      },
      "bundleIdentifier": "com.kazuki19992.strollia",
      "icon": "./assets/app.icon"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "blockedPermissions": ["android.permission.WRITE_EXTERNAL_STORAGE"],
      "package": "com.kazuki19992.strollia"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "すとろりあは、ジオタグ付き写真を地図上に表示したり、現在地アイコンに使用する画像を選択したりするために写真ライブラリを読み取ります。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "strollia",
          "organization": "kushida-software"
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "defaultChannel": "achievements",
          "color": "#1f7a5c"
        }
      ],
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "motionUsagePermission": "すとろりあは、移動ルートを記録する際に端末の移動状態を利用する場合があります。"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "すとろりあは、ジオタグ付き写真を地図上に表示したり、現在地アイコンに使用する画像を選択したりするために写真ライブラリを読み取ります。",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "description": "Strollia is a local-first GPS logger built with Expo.",
    "extra": {
      "eas": {
        "projectId": "76afa2eb-27a4-4486-b25f-a2fa730af7b2"
      }
    }
  }
}
