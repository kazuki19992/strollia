{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strollia.app/schemas/landmarkSpots.schema.json",
  "title": "Strollia landmark spots",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "prefectures", "areas", "packs"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "description": "UUIDv7。landmark_spot_visits.spot_id に保存する安定識別子"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "prefectures": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "description": "スポットが属する都道府県。富士山のように複数県にまたがるスポットを表現できるよう配列で持つ",
        "items": {
          "type": "string",
          "enum": [
            "HOKKAIDO",
            "AOMORI",
            "IWATE",
            "MIYAGI",
            "AKITA",
            "YAMAGATA",
            "FUKUSHIMA",
            "IBARAKI",
            "TOCHIGI",
            "GUNMA",
            "SAITAMA",
            "CHIBA",
            "TOKYO",
            "KANAGAWA",
            "NIIGATA",
            "TOYAMA",
            "ISHIKAWA",
            "FUKUI",
            "YAMANASHI",
            "NAGANO",
            "GIFU",
            "SHIZUOKA",
            "AICHI",
            "MIE",
            "SHIGA",
            "KYOTO",
            "OSAKA",
            "HYOGO",
            "NARA",
            "WAKAYAMA",
            "TOTTORI",
            "SHIMANE",
            "OKAYAMA",
            "HIROSHIMA",
            "YAMAGUCHI",
            "TOKUSHIMA",
            "KAGAWA",
            "EHIME",
            "KOCHI",
            "FUKUOKA",
            "SAGA",
            "NAGASAKI",
            "KUMAMOTO",
            "OITA",
            "MIYAZAKI",
            "KAGOSHIMA",
            "OKINAWA"
          ]
        }
      },
      "areas": {
        "type": "array",
        "minItems": 1,
        "description": "スポットの到達地点(円)。1件なら従来の円1つのスポット、2件以上なら全地点への到達でスポット到達(コンプリート)になる複数地点スポット",
        "items": {
          "type": "object",
          "required": ["latitude", "longitude", "radiusMeters", "dwellSeconds"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "description": "地点のUUIDv7。地点が2件以上のときだけ書く(1件のときは省略し、スポットIDを地点IDとして使う)。landmark_area_visits.area_id に保存する安定識別子。スポットIDとも他の地点IDとも重複できない"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "地点の表示名。地点が2件以上のときだけ書く(1件のときは省略し、スポット名を使う)"
            },
            "latitude": {
              "type": "number",
              "minimum": 20,
              "maximum": 46,
              "description": "地点の中心緯度"
            },
            "longitude": {
              "type": "number",
              "minimum": 122,
              "maximum": 154,
              "description": "地点の中心経度"
            },
            "radiusMeters": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 2000,
              "description": "到達判定の半径(メートル)。他の地点の円と重ねられない"
            },
            "dwellSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600,
              "description": "この地点の到達確定に必要な滞在時間(秒)"
            },
            "note": {
              "type": "string",
              "description": "座標や半径をその値にした理由のメモ"
            }
          }
        }
      },
      "packs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["packId", "order"],
          "additionalProperties": false,
          "properties": {
            "packId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "order": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "retired": {
        "type": "boolean"
      },
      "note": {
        "type": "string"
      }
    }
  }
}
