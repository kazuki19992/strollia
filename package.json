    "react-native-view-shot": "4.0.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "license-checker-rseidelsohn": "^4.4.2",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
