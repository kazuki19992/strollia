EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_ENABLE_PREMIUM_ACCESS_WITHOUT_REVENUECAT=false
# 写真ライブラリ走査の計測用（一時）。詳細は docs/photo-geotag.md §10「走査コストの計測フラグ」。
# EXPO_PUBLIC_PHOTO_SCAN_LIMIT: 走査上限（既定200件）の上書き。空・不正値・0以下なら既定値を使う。
# EXPO_PUBLIC_LOG_PHOTO_SCAN_METRICS: true のとき地図画面に走査の計測結果を表示する。
EXPO_PUBLIC_PHOTO_SCAN_LIMIT=
EXPO_PUBLIC_LOG_PHOTO_SCAN_METRICS=false
# Android の Google Maps 表示に使うキー（app.config.ts が android.config.googleMaps.apiKey へ注入）。
# EXPO_PUBLIC_ プレフィックス不要（ビルド時にネイティブ設定へ焼き込むため）。EASビルドでは同名のEAS環境変数も登録すること。
GOOGLE_MAPS_ANDROID_API_KEY=
