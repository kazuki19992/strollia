{
  "name": "strollia-expo",
  "version": "1.3.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "generate:licenses": "node scripts/generate-licenses.js",
    "generate:landmarks": "node scripts/generate-landmark-trophy-pngs.mjs && node scripts/generate-landmark-catalog.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/slider": "5.2.1",
    "@sentry/react-native": "~8.28.0",
    "buffer": "^6.0.3",
    "expo": "~58.0.21",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.19",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-media-library": "~58.0.13",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-task-manager": "~58.0.12",
    "fast-xml-parser": "^5.8.0",
    "gifenc": "^1.0.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-color-matrix-image-filters": "^8.0.2",
    "react-native-maps": "1.29.11",
    "react-native-purchases": "^10.4.2",
    "react-native-purchases-ui": "^10.4.2",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/upng-js": "^2.1.5",
    "ajv": "^8.20.0",
    "emojibase-data": "15.3.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.9.4",
    "react-dom": "19.3.0",
    "react-native-svg-transformer": "^1.5.3",
    "sharp": "^0.33.5",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.worktrees/",
      "<rootDir>/.claude/worktrees/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "\\.svg$": "<rootDir>/__mocks__/svgMock.js"
    },
    "clearMocks": true
  }
}
