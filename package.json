{
  "name": "strollia-expo",
  "version": "1.1.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "generate:licenses": "node scripts/generate-licenses.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/slider": "5.1.2",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@sentry/react-native": "~7.11.0",
    "expo": "^55.0.0",
    "expo-application": "~55.0.16",
    "expo-asset": "~55.0.17",
    "expo-blur": "~55.0.15",
    "expo-clipboard": "~55.0.14",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.36",
    "expo-document-picker": "~55.0.14",
    "expo-file-system": "~55.0.23",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.15",
    "expo-image-picker": "~55.0.21",
    "expo-keep-awake": "~55.0.8",
    "expo-linking": "~55.0.16",
    "expo-location": "~55.1.11",
    "expo-media-library": "~55.0.18",
    "expo-notifications": "~55.0.24",
    "expo-router": "~55.0.16",
    "expo-sharing": "~55.0.21",
    "expo-sqlite": "~55.0.17",
    "expo-status-bar": "~55.0.6",
    "expo-store-review": "~55.0.15",
    "expo-task-manager": "~55.0.17",
    "fast-xml-parser": "^5.8.0",
    "gifenc": "^1.0.3",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-color-matrix-image-filters": "^8.0.2",
    "react-native-maps": "1.27.2",
    "react-native-purchases": "^10.2.0",
    "react-native-purchases-ui": "^10.2.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-view-shot": "4.0.3",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "@types/upng-js": "^2.1.5",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.19",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.9.4",
    "react-dom": "19.2.0",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.worktrees/",
      "<rootDir>/.claude/worktrees/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "clearMocks": true
  }
}
